# ─── Server ───
PORT=5000
NODE_ENV=development

# ─── MongoDB ───
MONGODB_URI=mongodb://localhost:27017/drishti

# ─── Redis (for BullMQ) ───
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Video Storage ───
UPLOAD_DIR=./uploads
MAX_VIDEO_SLOTS=3

# ─── Gemini API (XAI Summaries) ───
GEMINI_API_KEY=your_gemini_api_key_here

# ─── ML Service ───
ML_SERVICE_URL=http://localhost:8000
